{
  "realm": "waystone",
  "displayName": "Waystone",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "groups": [
    {
      "name": "platform-users"
    },
    {
      "name": "platform-admins"
    }
  ],

  "clients": [
    {
      "clientId": "${WAYSTONE_BACKEND_CLIENT_ID}",
      "name": "Waystone Backend",
      "description": "Technical client used by the Waystone backend",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${WAYSTONE_BACKEND_CLIENT_SECRET}",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "waystone-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "${WAYSTONE_API_CLIENT_ID}",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "${WAYSTONE_API_CLIENT_ID}",
      "name": "Waystone API",
      "description": "Waystone REST API audience",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "${WAYSTONE_APP_CLIENT_ID}",
      "name": "Waystone App",
      "description": "Public client for Waystone Web and Mobile",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${WAYSTONE_APP_WEB_REDIRECT_URI}",
        "${WAYSTONE_APP_MOBILE_REDIRECT_URI}"
      ],
      "webOrigins": [
        "${WAYSTONE_APP_WEB_ORIGIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "waystone-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "${WAYSTONE_API_CLIENT_ID}",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "waystone-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-${WAYSTONE_BACKEND_CLIENT_ID}",
      "enabled": true,
      "serviceAccountClientId": "${WAYSTONE_BACKEND_CLIENT_ID}",
      "clientRoles": {
        "realm-management": [
          "manage-users"
        ]
      }
    }
  ]
}
